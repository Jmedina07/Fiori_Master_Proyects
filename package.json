{
  "name": "C25C385-2",
  "version": "0.0.1",
  "description": "Build and deployment scripts",
  "scripts": {
    "clean": "rimraf resources mta_archives mta-op*",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy C25C385-2 --delete-services --delete-service-keys --delete-service-brokers"
  },
  "devDependencies": {
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.3.19",
    "ui5-tooling-modules": "^3.34.0"
  }
}
