<mvc:View controllerName="com.logaligroup.invoices.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page id="page" title="{i18n>title}">

        <content>
<!-- No es tan común el uso de Vistas, por lo regular se usan fragmentos -->
            <mvc:XMLView 
                viewName="com.logaligroup.invoices.view.HelloPanel"
                type="XML" />
            <core:Fragment id="form01" 
                fragmentName="com.logaligroup.invoices.fragment.Form01" />

            <mvc:XMLView 
                viewName="com.logaligroup.invoices.view.InvoicesList"></mvc:XMLView>

        </content>

    </Page>


</mvc:View>