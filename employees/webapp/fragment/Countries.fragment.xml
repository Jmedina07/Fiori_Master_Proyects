<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="mySelectDialog"
		noDataText="No Products Found"
		title="Select Product"
		search="._handleValueHelpSearch"
		confirm=".onSelectDialogConfirm"
		cancel=".onSelectDialogConfirm"
		items="{
			path: 'countries>/Countries',
			length:500
		}">
		<StandardListItem
			title="{countries>code}"
			description="{countries>country}"
			icon="{countries>flag}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>