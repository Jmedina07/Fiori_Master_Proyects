<mvc:View
            controllerName="com.logaligroup.employees.controller.Details"
            xmlns="sap.m"
            xmlns:uxap="sap.uxap"
            xmlns:core="sap.ui.core"
            xmlns:mvc="sap.ui.core.mvc">


        <uxap:ObjectPageLayout>
        
            <uxap:headerTitle>
                <uxap:ObjectPageDynamicHeaderTitle>

                    <uxap:expandedHeading>
                        <Title text="{northwind>LastName}, {northwind>FirstName} ({northwind>EmployeeID})"/>
                    </uxap:expandedHeading>

                    <uxap:snappedHeading>
                        <Title text="{northwind>LastName}, {northwind>FirstName} ({northwind>EmployeeID})"/>
                    </uxap:snappedHeading>

                    <uxap:expandedContent>

                            <HBox
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>country}:" class="boldElement"/>
                                        <Text text="{northwind>Country}"/>
                                    </VBox>
                                </HBox>

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>city}:" class="boldElement"/>
                                        <Text text="{northwind>City}"/>
                                    </VBox>
                                </HBox>

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>postalCode}:" class="boldElement"/>
                                        <Text text="{northwind>PostalCode}"/>
                                    </VBox>
                                </HBox>

                            </HBox>
                            
                    </uxap:expandedContent>

                    <uxap:snappedContent>
                            <HBox
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>country}:" class="boldElement"/>
                                        <Text text="{northwind>Country}"/>
                                    </VBox>
                                </HBox>

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>city}:" class="boldElement"/>
                                        <Text text="{northwind>City}"/>
                                    </VBox>
                                </HBox>

                                <HBox>
                                    <VBox>
                                        <Label text="{i18n>postalCode}:" class="boldElement"/>
                                        <Text text="{northwind>PostalCode}"/>
                                    </VBox>
                                </HBox>

                            </HBox>
                    </uxap:snappedContent>

                    <uxap:actions>
                        <Button text="{i18n>create}"
                                tooltip="{i18n>create}"
                                press="onCreate"
                                type="Emphasized"></Button>
                        <Button
                                icon="sap-icon://decline"
                                press="onClosePress"
                                type="Transparent"/>
                    </uxap:actions>
                
                </uxap:ObjectPageDynamicHeaderTitle>
            </uxap:headerTitle>


            <uxap:sections>

                <uxap:ObjectPageSection >

                    <uxap:subSections>

                        <uxap:ObjectPageSubSection title="{i18n>incidence}">

                            <uxap:blocks >

                                <Panel id="tableIncidence"></Panel>

                            </uxap:blocks>

                        </uxap:ObjectPageSubSection>

                    </uxap:subSections>

                </uxap:ObjectPageSection>
            

                    <uxap:ObjectPageSection>
                    
                        <uxap:subSections>

                            <uxap:ObjectPageSubSection title="{i18n>orders}">

                                <uxap:blocks>

                                    <core:Fragment
                                                    fragmentName="com.logaligroup.employees.fragment.Orders"/>
                                
                                </uxap:blocks>
                            
                            </uxap:ObjectPageSubSection>
                        
                        </uxap:subSections>
                    
                    </uxap:ObjectPageSection>

            </uxap:sections>
        
        
        </uxap:ObjectPageLayout>


</mvc:View>