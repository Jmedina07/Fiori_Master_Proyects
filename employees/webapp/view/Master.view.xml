<mvc:View 
    controllerName="com.logaligroup.employees.controller.Master"
        xmlns="sap.m"
        xmlns:f="sap.f"
        xmlns:core="sap.ui.core"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns:fb="sap.ui.comp.filterbar">
    

    <f:DynamicPage id="idDynamicPage" >

        <f:title>

            <f:DynamicPageTitle id="idGenDynamicPageTitle" >

                <f:heading>

                    <Title  text="{i18n>appTitle}" />

                </f:heading>

            </f:DynamicPageTitle>

        </f:title>

        <f:header>

            <f:DynamicPageHeader id="idGenDynamicPageHeader" >
            
                <fb:FilterBar
                            search="onFilterSearchPress"
                            showClearOnFB="true"
                            clear="onClearPress"
                            >
                    
                    <fb:filterGroupItems>

                        <fb:FilterGroupItem
                                        groupName="filters"
                                        name="employee"
                                        label="{i18n>labelEmployee}"
                                        visibleInFilterBar="true">

                            <fb:control>

                                <Input/>
                            
                            </fb:control>
                        
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem groupName="filters1"
                                            name="country1"
                                            label="Countries"
                                            visibleInFilterBar="true">

                            <fb:control>
                                <Input
                                    id="productInput"
                                    type="Text"
                                    placeholder="Enter Country ..."
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    valueHelpRequest=".onSelectDialogPress"
                                    class="sapUiSmallMarginBottom"
                                    >
                                    <customData>
                                        <core:CustomData key="multi" value="true" />
                                        <core:CustomData key="resizable" value="true" />                                    
                                    </customData>
                                </Input> 



                               
                                <!-- <MultiComboBox id="idcmbStatus"
                                    selectionFinish="onSelectedKeys"
                                    placeholder="Status Filter"
                                    showSecondaryValues= "true"                                    
                                    width="80%"                    
                                    items="{
                                        path: 'countries>/Countries',
                                        sorter: { path: 'code' },
                                        length:500,
                                        templateShareable: false
                                    }">
                                    <items>
                                        <core:Item text="text" ></core:Item>
                                        <core:ListItem key="{countries>code}" 

                                        icon="{countries>flag}" 
                                        text="{countries>country}" 
                                        additionalText="{countries>flag}"/>
                                    </items>
                                </MultiComboBox> -->

  
                            </fb:control>
      
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem groupName="filters"
                                            name="country"
                                            label="{i18n>labelCountry}"
                                            visibleInFilterBar="true">
                            <fb:control>

                               

                                <ComboBox 
                                      items="{countries>/Countries}">                                
                                
                                    <items>
                                        <core:Item key="{countries>code}" 
                                                text="{countries>country}"/>
                                    </items>
                                    
                                </ComboBox>

                            
                            </fb:control>                            
                        
                        </fb:FilterGroupItem>

  
                    
                    </fb:filterGroupItems>


                
                
                </fb:FilterBar>            
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <Table  id="table"
                    items="{employees>/Employees}">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Employees (45)"/>
                        <ToolbarSpacer />
                        <Button
                                icon="sap-icon://download"
                                press="onExportToExcel"/>
                    </Toolbar>
                </headerToolbar>

                <columns>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>ID}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>country}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>city}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="false">
                        <Label text="{i18n>postalCode}"/>
                    </Column>
                
                </columns>

                <items>

                    <ColumnListItem type="Navigation"
                                    press="onNavToDetails">

                        <cells>

                            <ObjectIdentifier title="{employees>EmployeeID}" 
                                                text="{employees>LastName}, {employees>FirstName}"/>

                            <Text text="{employees>Country}"/>
                            <Text text="{employees>City}"/>
                            <Text text="{employees>PostalCode}"/>
                        
                        </cells>
                    
                    </ColumnListItem>
                
                </items>
            
            </Table>            
        </f:content>
    </f:DynamicPage>
</mvc:View>