<mvc:View 
    controllerName="com.logaligroup.employees.controller.Master"
        xmlns="sap.m"
        xmlns:f="sap.f"
        xmlns:core="sap.ui.core"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns:fb="sap.ui.comp.filterbar"
        core:require="{ MyFormmatter: 'com/logaligroup/employees/model/formatter' }"
        >
    

    <f:DynamicPage id="idDynamicPage" >

        <f:title>

            <f:DynamicPageTitle id="idGenDynamicPageTitle" >

                <f:heading>

                    <Title  text="{i18n>appTitle}" />

                </f:heading>

            </f:DynamicPageTitle>

        </f:title>

        <f:header>

            <f:DynamicPageHeader id="idGenDynamicPageHeader" >
            
                <fb:FilterBar
                            search="onFilterSearchPress"
                            showClearOnFB="true"
                            clear="onClearPress"
                            filterContainerWidth="15rem"
                            >
                    
                    <fb:filterGroupItems>

                        <fb:FilterGroupItem
                                        groupName="filters"
                                        name="employee"
                                        label="{i18n>labelEmployee}"
                                        visibleInFilterBar="true">

                            <fb:control>

                                <Input/>
                            
                            </fb:control>
                        
                        </fb:FilterGroupItem>


                        <fb:FilterGroupItem groupName="filtercountry"
                                        name="country"
                
                                        label="{i18n>labelCountry}"
                                        visibleInFilterBar="true">
                            <fb:control>

                                <MultiInput width="150%"
                                    id="multiInput"
                                    suggestionItems="{
                                        path: 'countries>/Countries',
                                        sorter: { path: 'country' }
                                    }"
                                    valueHelpRequest="onSelectDialogPress">
                                    <customData>
                                        <core:CustomData key="multi" value="true" />
                                                        
                                    </customData>                                    
                                    <core:Item key="{countries>code}" text="{countries>country}" />
                                </MultiInput>                               
                            
                            </fb:control>                            
                    
                        </fb:FilterGroupItem>


                        <fb:FilterGroupItem groupName="filterStatus"
                                        name="Status"
                                        label="{i18n>labelStatus}"
                                        visibleInFilterBar="true">
                            <fb:control>
                                <MultiComboBox id="idcmbStatus"

                                    placeholder="Status Filter"
                                    width="30%"
                                    items="{
                                        path: 'status>/Status',
                                        sorter: { path: 'StatusID' }
                                    }">
                                    <items>
                                        <core:ListItem key="{status>StatusID}" text="{status>Estatus}"/>
                                    </items>
                                </MultiComboBox>

                            </fb:control>                            
                    
                        </fb:FilterGroupItem>
                    
                    </fb:filterGroupItems>


                
                
                </fb:FilterBar>            
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <Table  id="table"
                    items="{northwind>/Employees}"
                    updateFinished="onTableUpdateFinished"
                    growing="true" 
                    growingThreshold="20"                    
                    >

                <headerToolbar>
                    <Toolbar>
                        <Title id="myRows" text="Employees"/>
                        <ToolbarSpacer />
                        <Button
                                icon="sap-icon://download"
                                class ="iconDownload"
                                press="onExportToExcel"/>
                    </Toolbar>
                </headerToolbar>

                <columns>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>ID}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>country}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="true">
                        <Label text="{i18n>city}"/>
                    </Column>

                    <Column minScreenWidth="Small"
                            demandPopin="false">
                        <Label text="{i18n>postalCode}"/>
                    </Column>
                    <Column minScreenWidth="Small"
                            demandPopin="false">
                        <Label text="{i18n>status}"/>
                    </Column>                    
                
                </columns>

                <items>

                    <ColumnListItem type="Navigation"
                                    press="onNavToDetails">

                        <cells>

                            <ObjectIdentifier title="{northwind>EmployeeID}" 
                                                text="{northwind>LastName}, {northwind>FirstName}"/>

                            <Text text="{northwind>Country}"/>
                            <Text text="{northwind>City}"/>
                            <Text text="{northwind>PostalCode}"/>
                            <!-- <Text text="{northwind>StatusID}"/> -->
                            <!-- <ObjectStatus 
                            text="{
                                path: 'northwind>StatusID',
                                formatter: 'MyFormmatter.statusText.bind($controller)' 
                                
                                }"
                            />                             -->
                        
                        </cells>
                    
                    </ColumnListItem>
                
                </items>
            
            </Table>            
        </f:content>
    </f:DynamicPage>
</mvc:View>