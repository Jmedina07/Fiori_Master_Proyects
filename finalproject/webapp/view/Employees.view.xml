<mvc:View
            controllerName="com.logaligroup.finalproject.controller.Employees"
        xmlns="sap.m"
        xmlns:f="sap.f"
        xmlns:core="sap.ui.core"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns:fb="sap.ui.comp.filterbar">

    <f:DynamicPage >

        <f:header>

            <f:DynamicPageHeader>
                <HBox >
                    <Button icon="sap-icon://nav-back" press=".onClosePress"></Button>
                    <Input placeholder="Buscar" submit="onSearch"/>
                </HBox>
                          
            </f:DynamicPageHeader>
        
        </f:header>

        <f:content>

            <Table  id="table"
                    items="{mEmployees>/}">

                <columns>

                    <Column>
                        <Label text="{i18n>ID}"/>
                    </Column>

                    <Column>
                        <Label text="{i18n>dni}"/>
                    </Column>

                </columns>

                <items>

                    <ColumnListItem press="onNavToDetails" type="Navigation">

                        <cells>

                            <ObjectIdentifier title="{mEmployees>EmployeeId}" 
                                                text="{mEmployees>LastName}, {mEmployees>FirstName}"/>

                            <Text text="{mEmployees>Dni}"/>
                        
                        </cells>
                    
                    </ColumnListItem>
                
                </items>
            
            </Table>
        

        </f:content>
    
    </f:DynamicPage>


</mvc:View>