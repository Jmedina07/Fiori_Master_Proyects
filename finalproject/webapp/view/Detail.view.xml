<mvc:View
    controllerName="com.logaligroup.finalproject.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:upload="sap.m.upload"
    xmlns="sap.m">

    <Page >
        <ObjectHeader id="header"
            title="{Name}"
            backgroundDesign="Solid"
            number="{
                parts:[{path:'Price'},{path:'CurrencyCode'}],
                type: 'sap.ui.model.type.Currency',
                formatOptions: {showMeasure: false}
            }"
            numberUnit="{CurrencyCode}" >
            <attributes>
                <ObjectAttribute title="Weight" text="{WeightMeasure} {WeightUnit}" />
                <ObjectAttribute title="Dimensions" text="{Width} x {Depth} X {Height} {DimUnit}" />
            </attributes>
            <statuses>
                <ObjectStatus title="Status" text="In Stock" state="Success" />
            </statuses>
        </ObjectHeader>
        <content>
            <IllustratedMessage id="idMessage"
                illustrationType="sapIllu-SelectOrders"
                title="Seleccione un Empleado"
                description="Por favor, elija un registro de la lista para ver el detalle."
                visible="{= !${/selectedEmployee} }" />  

        <IconTabBar 
            id="idIconTabBar"
            select=".onFilterSelect"
            class="sapUiResponsiveContentPadding">

            <items>
                <IconTabFilter
                    icon="sap-icon://attachment"
                    iconColor="Default"
                    design="Horizontal"
                    count="{/ProductCollectionStats/Counts/Weight/Ok} of {/ProductCollectionStats/Counts/Total}"
                    text="{i18n>lblFiles2}"
                    key="Ok">
                    <upload:UploadSet
                        id="upload1"
                        uploadUrl="/sap/opu/odata/sap/ZEMPLOYEES_SRV/Attachments/"
                        beforeUploadStarts="onBeforeUpload"
                        uploadCompleted="onUploadCompleted"
                        instantUpload="false"
                        afterItemAdded="onFileAdded"
                        afterItemRemoved="onFileRemoved"
                        >
                    </upload:UploadSet>                    
                </IconTabFilter>
                    
                <IconTabFilter
                    icon="sap-icon://money-bills"
                    iconColor="Default"
                    design="Horizontal"
                    count="{/ProductCollectionStats/Counts/Weight/Heavy} of {/ProductCollectionStats/Counts/Total}"
                    text="{i18n>lblHistorial}"
                    key="Heavy">

                    <Label text="Texto de prueba"/>

                </IconTabFilter>
            </items>
            <content>
            
            </content>
        </IconTabBar>

        </content>
    
    </Page>



</mvc:View>