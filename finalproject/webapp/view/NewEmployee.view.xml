<mvc:View controllerName="com.logaligroup.finalproject.controller.NewEmployee"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
	height="100%">
	<NavContainer id="navContainer">
		<pages>
			<f:DynamicPage
				id="dynamicPage"
				toggleHeaderOnTitleClick="{/titleClickable}"
				stickySubheaderProvider="ShoppingCartWizard"
				class="sapUiNoContentPadding"
				showFooter="true">
				<!-- DynamicPage Title -->
				<f:title>
					<f:DynamicPageTitle>
						<f:heading>
							<Title text="{i18n>wizardheader}" textAlign="Center"/>
						</f:heading>
						<f:navigationActions>
							<Button
								text="Regresar"
								icon="sap-icon://nav-back"
								type="Transparent"
								press=".onClosePress"
							/>
						</f:navigationActions> 
					</f:DynamicPageTitle>
				</f:title>
				<!-- DynamicPage Header -->
				<f:content>
					<Wizard id="employeeWizard"
					        class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
					        complete="completedHandler"
					        height="auto"
					        enableBranching="true">
						<WizardStep
							id="ContentsStep"
							nextStep="steptwo"
							activate="checkstepone"
							title="{i18n>wizardname1}"
							validated="true">
                            <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    width="100%">
                                <SegmentedButton
                                    width="320px" id="butonselect" 
                                    selectionChange="onSegmentedButtonChange"
									selectedKey="{/selectedOption}"
									>
                                    <items>
                                        <SegmentedButtonItem icon="sap-icon://iphone" text="{i18n>tipoempleado1}" key="{i18n>tipoempleado1}" width="100px" />
                                        <SegmentedButtonItem icon="sap-icon://sys-monitor" text="{i18n>tipoempleado2}" key="{i18n>tipoempleado2}" width="150px"/>
                                        <SegmentedButtonItem icon="sap-icon://database" text="{i18n>tipoempleado3}" key="{i18n>tipoempleado3}" width="100px"/>
                                    </items>
                                </SegmentedButton>
                            </HBox>

						</WizardStep>
						<WizardStep
							id="steptwo"
							title="{i18n>wizardname2}"
							subsequentSteps="stepthree"
                            activate="checksteptwo"
							complete="steptwoComplete"
							icon="sap-icon://money-bills">
							<!-- <Text class="sapUiSmallMarginBottom"
							      text="We accept all major credit cards. No extra cost will be charged when paying with a credit card. Bank transfer and Cash on delivery are only possible for inland deliveries. A service charge of 2.99 EUR will be charged for these types of deliveries. Be aware, that for Bank transfers, the shipping will start on the day after the payment is received."/> -->
								<form:SimpleForm
										editable="true"
										layout="ResponsiveGridLayout">

									<MessageStrip
										text="{i18n>messageform1}"
										type="Information"
										showIcon="true" 
										class="sapUiMediumMarginBottom">
									</MessageStrip>      

									<Label text="{i18n>lblname}" required="true"/>
									<Input  id="Name" liveChange="checksteptwo"
											placeholder="{i18n>placename}" value="{/steptwo/name}" />
                                            
									<Label text="{i18n>lblapellido}" required="true"/>
									<Input valueStateText="Enter digits"
											id="Apellido"
											liveChange="checksteptwo" placeholder="{i18n>placeapellido}"
											value="{/steptwo/apellido}"/>

									<Label text="{i18n>lbldni}" required="true"/>
									<Input valueStateText="Enter digits"
											id="Dni" type="Number"
											liveChange="checksteptwo" placeholder="{i18n>placedni}"
											value="{/steptwo/dni}"/>

									<Label text="{i18n>lblcif}" required="true"/>
									<Input valueStateText="Enter digits"
											id="Cif" type="Number"
											liveChange="checksteptwo" placeholder="{i18n>placecif}"
											value="{/steptwo/cif}"/>

									<Label text="{i18n>lblsalario}" required="true"/>
									<Slider enableTickmarks="true" class="sapUiMediumMarginBottom" min="12000" max="80000" value="24000" id="Salario" />

									<Label text="{i18n>lblprecio}" required="true"/>
									<Slider enableTickmarks="true" class="sapUiMediumMarginBottom" min="100" max="2000" value="400" id="Precio" />

									<Label text="{i18n>lbldate}"/>
									<DatePicker value="{/steptwo/date}" id="date" valueFormat="yyyy-MM-dd" displayFormat="long" liveChange="checksteptwo"/>

								</form:SimpleForm>

						</WizardStep>
						<WizardStep
							id="stepthree"
							title="{i18n>wizardname3}"
							icon="sap-icon://credit-card">
							<MessageStrip text="{i18n>messageform2}"/>
							<form:SimpleForm
								editable="true"
								layout="ColumnLayout">
								<Label text="{i18n>lblnote}" required="false"/>
								<TextArea rows="8" value="{/stepthree/Note}"/>						
							</form:SimpleForm>
						</WizardStep>
					</Wizard>
				</f:content>
				<!-- DynamicPage Footer -->
				<f:footer>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<Button type="Accept" text="{i18n>buton4}" id="savebuton"/>
						<Button type="Reject" text="{i18n>buton5}" press="handleWizardCancel"/>
					</OverflowToolbar>
				</f:footer>
			</f:DynamicPage>
			<Page id="wizardReviewPage" showHeader="false">
				<content>
					<form:SimpleForm
						title="1. {i18n>wizardname1}"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<Label text="Tipo"/>
							<Text text="{/selectedOption}"/>
							<Link press="handleNavBackToFirst" text="Edit"/>
						</form:content>
					</form:SimpleForm>

					<form:SimpleForm
						title="2. {i18n>wizardname2}"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<Label text="{i18n>lblname}"/>
							<Text text="{/steptwo/name}"/>
							<Label text="{i18n>lblapellido}"/>
							<Text text="{/steptwo/apellido}"/>
							<Label text="{i18n>lbldni}" id="lbldni"/>
							<Text text="{/steptwo/dni}" id="txtdni"/>
							<Label text="{i18n>lblcif}" id="lblcif"/>
							<Text text="{/steptwo/cif}" id="txtcif"/>

							<Label text="Expiration date"/>
							<Text text="{/CreditCard/Expire}"/>
							<Link press="handleNavBackToTwo" text="Edit"/>
						</form:content>
					</form:SimpleForm>

					<form:SimpleForm
						visible="true"
						title="3. Bank Transfer"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<layout:Grid
								defaultSpan="L6 M6 S10"
								hSpacing="2">
								<Label text="Beneficiary Name" design="Bold"/>
								<Label text="Singapore Hardware e-Commerce LTD"/>
								<Label text="Beneficiary Bank" design="Bold"/>
								<Label text="CITY BANK, SINGAPORE BRANCH"/>
								<Label text="Beneficiary Account Number" design="Bold"/>
								<Label text="06110702027218"/>
								<Label text="Bank Phone Number" design="Bold"/>
								<Label text="+65-6224-2622"/>
								<Label text="Bank Email Address" design="Bold"/>
								<Label text="customerservice@citybank.com"/>
								<Link press="handleNavBackToThree" text="Edit"></Link>
							</layout:Grid>
						</form:content>
					</form:SimpleForm>

					<form:SimpleForm
						visible="{= ${/selectedPayment}==='Cash on Delivery' ? true : false}"
						title="3. Cash on delivery"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<Label text="First Name"/>
							<Text text="{/CashOnDelivery/FirstName}"/>
							<Label text="Last Name"/>
							<Text text="{/CashOnDelivery/LastName}"/>
							<Label text="Phone number"/>
							<Text text="{/CashOnDelivery/Phone Number}"/>
							<Label text="Email address"/>
							<Text text="{/CashOnDelivery/Email}"/>
							<Link press="handleNavBackToCashOnDelivery" text="Edit"/>
						</form:content>
					</form:SimpleForm>

					<form:SimpleForm
						title="4. Billing Address"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<Label text="Address"/>
							<Text text="{/BillingAddress/Address}"/>
							<Label text="City"/>
							<Text text="{/BillingAddress/City}"/>
							<Label text="Zip Code"/>
							<Text text="{/BillingAddress/ZipCode}"/>
							<Label text="Country"/>
							<Text text="{/BillingAddress/Country}"/>
							<Label text="Note"/>
							<Text text="{/BillingAddress/Note}"/>
							<Link press="handleNavBackToBillingAddress" text="Edit"/>
						</form:content>
					</form:SimpleForm>

					<form:SimpleForm
						title="5. Delivery type"
						editable="false"
						layout="ResponsiveGridLayout">
						<form:content>
							<Label text="Chosen delivery type"/>
							<Text text="{/selectedDeliveryMethod}"/>
							<Link press="handleNavBackToDeliveryType" text="Edit"/>
						</form:content>
					</form:SimpleForm>
				</content>
				<footer>
					<Bar>
						<contentRight>
							<Button text="{i18n>buton4}" press="handleWizardSave" id="Save"/>
							<Button text="{i18n>buton5}" press="handleWizardCancel"/>
						</contentRight>
					</Bar>
				</footer>
			</Page>
		</pages>
	</NavContainer>

</mvc:View>