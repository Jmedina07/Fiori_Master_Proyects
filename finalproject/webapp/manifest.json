{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.logaligroup.finalproject",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.6",
      "toolsId": "9cca3540-d221-4215-8d9e-468fd41cd9d6"
    },
    "dataSources": {
      "ZEMPLOYEES_SRV": {
        "uri": "/sap/opu/odata/sap/ZEMPLOYEES_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZEMPLOYEES_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.logaligroup.finalproject.i18n.i18n"
        }
      },
      "zemployees": {
        "dataSource": "ZEMPLOYEES_SRV",
        "preload": true,
        "settings": {
          "useBatch": false,
          "defaultBindingMode": "TwoWay",
          "defaultUpdateMethod": "PUT"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.logaligroup.finalproject.view",
        "async": true
      },
      "routes": [
        {
          "name": "menu",
          "pattern": "",
          "target": "TargetMenu"
        },
        {
          "pattern": "RouteEmployees",
          "name": "RouteEmployees",
          "target": [
            "TargetEmployees"
          ]
        },
        {
          "pattern": "RouteNewEmployee",
          "name": "RouteNewEmployee",
          "target": [
            "TargetContainer",
            "TargetNewEmployee"
          ]
        },
        {
          "pattern": "Employee({ID})",
          "name": "RouteDetail",
          "target": [
            "TargetEmployees",
            "TargetDetail"
          ]
        }     
      ],
      "targets": {
        "TargetContainer": {
          "name": "Container"
        },
        "TargetNewEmployee": {
          "viewId": "NewEmployee",
          "name": "NewEmployee"
        },
        "TargetMenu": {
          "name": "Menu"
        },
        "TargetEmployees": {
          "parent": "TargetContainer",
          "name": "Employees",
          "controlId": "container-fcl",
          "controlAggregation": "beginColumnPages"
        },
        "TargetDetail": {
          "parent": "TargetContainer",
          "name": "Detail",
          "controlId": "container-fcl",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "com.logaligroup.finalproject.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}