{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.logaligroup.finalproject",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.6",
      "toolsId": "9cca3540-d221-4215-8d9e-468fd41cd9d6"
    },
    "dataSources": {
      "YSAPUI5_SRV_01": {
        "uri": "/sap/opu/odata/sap/YSAPUI5_SRV_01/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/YSAPUI5_SRV_01/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZEMPLOYEES_SRV": {
        "uri": "/sap/opu/odata/sap/ZEMPLOYEES_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZEMPLOYEES_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.logaligroup.finalproject.i18n.i18n"
        }
      },
      "zinvoices": {
        "dataSource": "YSAPUI5_SRV_01",
        "preload": true,
        "settings": {
          "useBatch": false,
          "defaultBindingMode": "TwoWay",
          "defaultUpdateMethod": "PUT"
        }
      },      
      "zemployees": {
        "dataSource": "ZEMPLOYEES_SRV",
        "preload": true,
        "settings": {
          "useBatch": false,
          "defaultBindingMode": "TwoWay",
          "defaultUpdateMethod": "PUT"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.logaligroup.finalproject.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteMaster",
          "pattern": "",
          "target": [
            "TargetContainer",
            "TargetMaster"
          ]
        },
        {
          "pattern": "detail1", 
          "name": "detalleProducto1",
          "target": [
            "TargetContainer",
            "TargetDetail1"
          ] 
        },
        {
          "pattern": "detail2",
          "name": "detalleProducto2",
          "target": [
            "TargetContainer",
            "TargetDetail2"
          ] 
        } ,
        {
          "pattern": "",
          "name": "master",
          "target": ["Container", "Master"]
        },
        {
          "pattern": "employees",
          "name": "employees",
          "target": ["Container", "Employees"]
        },
        {
          "pattern": "newEmployee",
          "name": "newEmployee",
          "target": ["Container", "NewEmployee"]
        }

      ],
      "targets": {
        "TargetContainer": {
          "name": "Container"
        },
        "TargetMaster": {
          "parent": "TargetContainer",
          "controlId": "container-fcl",
          "controlAggregation": "beginColumnPages",
          "name": "Master"
        },
        "TargetDetail1": {
          "parent": "TargetContainer",
          "controlId": "container-fcl",
          "controlAggregation": "endColumnPages",
          "name": "NewEmployee"
        },
        "TargetDetail2": {
          "parent": "TargetContainer",
          "controlId": "container-fcl",
          "controlAggregation": "endColumnPages",
          "name": "Employees"
        },
        "Container": {
          "viewId": "Container",
          "name": "Container"
        },
        "Master": {
          "viewId": "Master",
          "name": "Master"
        },
        "Employees": {
          "viewId": "Employees",
          "name": "Employees"
        },
        "NewEmployee": {
          "viewId": "NewEmployee",
          "name": "NewEmployee"
        }        
      }
    },
    "rootView": {
      "viewName": "com.logaligroup.finalproject.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}